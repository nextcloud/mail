{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ESNext",
		"strict": false,
		"strictNullChecks": true,
		"noUncheckedSideEffectImports": false,
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"declaration": false,
	},
	"include": [
		"./src/**/*"
	]
}
